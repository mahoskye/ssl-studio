  "Sample/Orders.ssl": {
   "text": "/********************************************************************************\nDescription.. : Sample script for SSL Studio: order helpers.\nParameters... : -\nReturns...... : -\nAuthor....... :\nDate......... : 2026-11-01\n********************************************************************************\n_______________________________________________________________________________\nModification. : Added CountOpenOrders.\nAuthor....... :\nDate......... : 2026-11-01\n_______________________________________________________________________________\nModification. : First version.\nAuthor....... :\nDate......... : 2026-10-31\n_______________________________________________________________________________\n********************************************************************************/;\n\n/* region Queries;\n\n/*\n * Procedure: CountOpenOrders\n * Description: Counts the orders still open for a customer.\n * Parameters:\n *   sCustomer - the customer code\n * Returns: the number of open orders\n;\n:PROCEDURE CountOpenOrders;\n\t:PARAMETERS sCustomer;\n\t:DEFAULT sCustomer, \"\";\n\n\t:DECLARE nCount;\n\n\t:IF Empty(sCustomer);\n\t\t:RETURN 0;\n\t:ENDIF;\n\n\tnCount := LSearch(\"SELECT COUNT(*) FROM ORDERS WHERE CUSTNO = ? AND STATUS = ?\", 0, \"DATABASE\", {sCustomer, \"Open\"});\n\n\t:RETURN nCount;\n:ENDPROC;\n\n/* endregion;\n\n/* region Formatting;\n\n/*\n * Procedure: OrderTitle\n * Description: A short title for an order.\n * Parameters:\n *   sOrdNo - the order number\n *   nItems - how many items it has\n * Returns: the title\n;\n:PROCEDURE OrderTitle;\n\t:PARAMETERS sOrdNo, nItems;\n\n\t:DECLARE sTitle, i;\n\n\tsTitle := \"Order \" + sOrdNo;\n\n\t:FOR i := 1 :TO nItems;\n\t\tsTitle := sTitle + \".\";\n\t:NEXT;\n\n\t:TRY;\n\t\tsTitle := Upper(sTitle);\n\t:CATCH;\n\t\tsTitle := \"Order\";\n\t:ENDTRY;\n\n\t:RETURN sTitle;\n:ENDPROC;\n\n/* endregion;\n",
