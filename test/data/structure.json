  "Regions.ssl": {
   "text": "/********************************************************************************\nDescription.. : Spike fixture: regions, procedures and control flow.\nParameters... : -\nReturns...... : -\nAuthor....... :\nDate......... : 2026-10-31\n********************************************************************************\n_______________________________________________________________________________\nModification. :\nAuthor....... :\nDate......... :\n_______________________________________________________________________________\n********************************************************************************/;\n\n/* region Validation;\n\n/*\n    Checks that a sample id is present and well formed.\n\n    sSampleId - the id to check\n    Returns .T. when the id is usable\n;\n:PROCEDURE IsUsableId;\n:PARAMETERS sSampleId;\n:DEFAULT sSampleId, \"\";\n\n:IF Empty(sSampleId);\n    :RETURN .F.;\n:ENDIF;\n\n:RETURN Len(sSampleId) <= 20;\n:ENDPROC;\n\n/* endregion;\n\n/* region Labels;\n\n/*\n    The label text for a status code.\n\n    nStatus - the status code\n    Returns the label\n;\n:PROCEDURE StatusLabel;\n:PARAMETERS nStatus;\n\n:DECLARE sLabel;\n\n:BEGINCASE;\n:CASE nStatus == 1;\n    sLabel := \"Logged\";\n:CASE nStatus == 2;\n    sLabel := \"Released\";\n:OTHERWISE;\n    sLabel := \"Unknown\";\n:ENDCASE;\n\n:RETURN sLabel;\n:ENDPROC;\n\n/* endregion;\n\n:REGION sqlPending;\n    SELECT ORDNO FROM ORDERS WHERE STATUS = ?\n:ENDREGION;\n",
