{
  "version": 1,
  "title": "Release a sample",
  "goal": "Release a sample once its results are approved, and tell the lab.",
  "targets": ["Sample/Release.ssl"],
  "groups": [
    { "id": "g1", "name": "Validation" }
  ],
  "nodes": [
    { "id": "n1", "kind": "start", "text": "A sample id arrives" },
