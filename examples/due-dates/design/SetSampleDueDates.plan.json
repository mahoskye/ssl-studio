  "built": {
    "units": [
      { "name": "LoadHolidays", "script": "src/DueDates/SetSampleDueDates.ssl", "parameters": [], "nodes": ["n2"], "calls": ["DueDates.Holidays"] },
      { "name": "LoadOutages", "script": "src/DueDates/SetSampleDueDates.ssl", "parameters": [], "nodes": ["n3"], "calls": ["DueDates.Outages"] },
      { "name": "ApplyDueDates", "script": "src/DueDates/SetSampleDueDates.ssl", "parameters": ["aHolidays","aOutages"], "nodes": ["n4","n5","n10","n11","n12","n25"], "calls": ["PlanDueDate","DueDates.SaveDueDates","DueDates.DueDateSummary.Combine"] },
      { "name": "PlanDueDate", "script": "src/DueDates/SetSampleDueDates.ssl", "parameters": ["aSample","aHolidays","aOutages"], "nodes": ["n6","n7","n8","n9"], "calls": ["DueDates.DueRules.RuleFor","SkipNoReceived","SkipNoTurnaround","SkipNotReached"] },
      { "name": "Combine", "script": "src/DueDates/DueDateSummary.ssl", "parameters": ["aPlanSkips","aSaved"], "nodes": ["n24"], "calls": [] },
      { "name": "WriteDueDates", "script": "src/DueDates/SaveDueDates.ssl", "parameters": ["aPlanned"], "nodes": ["n13","n14","n16","n17","n19","n20","n21"], "calls": ["IsPlannedRow","SaveDueDate","SkipNotWaiting"] },
      { "name": "IsPlannedRow", "script": "src/DueDates/SaveDueDates.ssl", "parameters": ["vRow"], "nodes": ["n15"], "calls": [] },
