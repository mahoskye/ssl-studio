{
  "version": 1,
  "title": "Set sample due dates",
  "goal": "Give every sample that has no due date one, counting only days the lab is working and the sample's instrument is available.",
  "targets": ["src/DueDates/SetSampleDueDates.ssl","src/DueDates/SaveDueDates.ssl","src/DueDates/DueDateSummary.ssl"],
  "groups": [
    { "id": "g1", "name": "Loading" },
    { "id": "g2", "name": "Planning one sample" },
    { "id": "g3", "name": "Saving, in SaveDueDates" }
  ],
  "nodes": [
    { "id": "n1", "kind": "start", "text": "Run, with no parameters" },
    { "id": "n2", "kind": "call", "text": "Read the holidays", "ref": "LoadHolidays", "group": "g1" },
    { "id": "n3", "kind": "call", "text": "Read the outages", "ref": "LoadOutages", "group": "g1" },
    { "id": "n4", "kind": "step", "text": "Read the samples that have no due date", "notes": "No transaction is open: reading and working out come first." },
    { "id": "n5", "kind": "decision", "text": "Is there another sample to plan?" },
    { "id": "n6", "kind": "decision", "text": "Has it a received date and a turnaround?", "group": "g2" },
    { "id": "n7", "kind": "call", "text": "Pick the rule for its priority", "ref": "DueDates.DueRules.RuleFor", "group": "g2", "notes": "RUSH gets the rule that counts Saturdays." },
    { "id": "n8", "kind": "step", "text": "Work out the due date with the rule", "group": "g2", "notes": "The rule's DueDate. A day counts when it is a working day and the instrument is available. It gives no date when the turnaround is not reached within 730 days." },
    { "id": "n9", "kind": "decision", "text": "Did the rule give a date?", "group": "g2" },
    { "id": "n10", "kind": "step", "text": "Keep the date, to save later" },
    { "id": "n11", "kind": "step", "text": "Note the sample as skipped, with a code and the reason" },
    { "id": "n12", "kind": "step", "text": "Hand the planned dates to SaveDueDates", "notes": "SaveDueDates is its own script: it saves all of the dates or none, and owns the one transaction. If it fails, this script fails with DUE_DATES_NOT_SAVED." },
    { "id": "n13", "kind": "step", "text": "Begin a transaction", "group": "g3", "notes": "Any error from here rolls every write of the call back." },
    { "id": "n14", "kind": "decision", "text": "Is there another planned row?", "group": "g3" },
    { "id": "n15", "kind": "call", "text": "Check the row is a sample and a day", "ref": "IsPlannedRow", "group": "g3" },
    { "id": "n16", "kind": "decision", "text": "Is it?", "group": "g3" },
    { "id": "n17", "kind": "step", "text": "Raise: the rows written before it are taken back", "group": "g3" },
    { "id": "n18", "kind": "call", "text": "Write the due date, if the sample still has none", "ref": "SaveDueDate", "group": "g3" },
    { "id": "n19", "kind": "decision", "text": "Was the sample's row changed?", "group": "g3" },
    { "id": "n20", "kind": "step", "text": "Note the sample as no longer waiting", "group": "g3" },
    { "id": "n21", "kind": "step", "text": "Commit the transaction", "group": "g3" },
    { "id": "n22", "kind": "end", "text": "Return DUE_DATES_NOT_SAVED: nothing was saved" },
    { "id": "n23", "kind": "end", "text": "Return how many were set, and which were skipped and why" },
    { "id": "n24", "kind": "call", "text": "Join the skips, and read what saving answered", "ref": "DueDates.DueDateSummary.Combine", "notes": "It raises nothing: it says what was wrong with the answer, if anything, so each case is tested without a database. The skips found while planning come first." },
    { "id": "n25", "kind": "decision", "text": "Was anything wrong with the answer?", "notes": "A save that failed, or an answer that is not a summary. SaveDueDates as written only gives the first, with nothing saved." }
  ],
  "edges": [
    { "from": "n1", "to": "n2" },
    { "from": "n2", "to": "n3" },
