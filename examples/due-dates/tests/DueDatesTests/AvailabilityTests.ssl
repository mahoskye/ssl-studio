/********************************************************************************
Description.. : Unit tests for IsAvailable and NextAvailableDay of DueDates.Availability.
                No database is read or written.
                Run DueDatesTests.AvailabilityTests.RunTests. It returns the tally.
Parameters... : -
Returns...... : -
Author....... :
Date......... : 2026-11-17
********************************************************************************
_______________________________________________________________________________
Modification. : The runner is the shared one, trimmed ids, the empty date and the
                day limit are tested, and OutageDays has a script of its own.
Author....... :
Date......... : 2026-11-18
_______________________________________________________________________________
********************************************************************************/;

:INCLUDE DueDates.DueDateConstants;

/*
 * Procedure: RunTests
 * Description: Runs every test of this script, each on its own.
 * Returns: {nPassed, nTotal, aResults}, each result {sLabel, bPassed}
;
:PROCEDURE RunTests;
	:DECLARE aArgs, aTests;

	aTests := {
		"TestAvailableNoOutages", "TestUnavailableLastDay",
		"TestAvailableOtherInstrument", "TestAvailableNoInstrument",
		"TestAvailableExactId", "TestTrimmedIdAsked", "TestTrimmedIdInRow",
		"TestNextAvailableSameDay", "TestNextAvailableAfterOutage",
		"TestNextAvailableEmptyDate", "TestNextAvailableDayLimit"
	};
	aArgs := {"DueDatesTests.AvailabilityTests", aTests};

	:RETURN ExecFunction("DueDatesTests.TestSupport.RunAll", aArgs);
:ENDPROC;

/* region On one day;

:PROCEDURE TestAvailableNoOutages;
	/* Empty case: with no outages listed, an instrument is available;
	:DECLARE aArgs, bActual;

	aArgs := {"BAL-01", DateFromNumbers(2026, 11, 18), {}};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"No outages, always available", .T., bActual};
:ENDPROC;

:PROCEDURE TestUnavailableLastDay;
	/* Thursday 19 is the last day of the BAL-01 outage, and that day is included;
	:DECLARE aArgs, aOutages, bActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {"BAL-01", DateFromNumbers(2026, 11, 19), aOutages};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"Out on the last day of an outage", .F., bActual};
:ENDPROC;

:PROCEDURE TestAvailableOtherInstrument;
	/* HPLC-02 is not held up by the BAL-01 outage on Wednesday 18;
	:DECLARE aArgs, aOutages, bActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {"HPLC-02", DateFromNumbers(2026, 11, 18), aOutages};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"Another instrument is not affected", .T., bActual};
:ENDPROC;

:PROCEDURE TestAvailableNoInstrument;
	/* Work that needs no instrument ignores every outage;
	:DECLARE aArgs, aOutages, bActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {"", DateFromNumbers(2026, 11, 18), aOutages};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"No instrument, always available", .T., bActual};
:ENDPROC;

:PROCEDURE TestAvailableExactId;
	/* BAL is not BAL-01: an id that is only the start of another does not match;
	:DECLARE aArgs, aOutages, bActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {"BAL", DateFromNumbers(2026, 11, 18), aOutages};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"An id that is only a prefix does not match", .T., bActual};
:ENDPROC;

:PROCEDURE TestTrimmedIdAsked;
	/* The id asked for has spaces round it and is in lower case. It is BAL-01 all the same;
	:DECLARE aArgs, aOutages, bActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {" bal-01 ", DateFromNumbers(2026, 11, 18), aOutages};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"The id asked for is trimmed, any case", .F., bActual};
:ENDPROC;

:PROCEDURE TestTrimmedIdInRow;
	/* The same on the other side: an outage row typed as "bal-01 " is BAL-01's;
	:DECLARE aArgs, aOutages, bActual, dDay;

	dDay := DateFromNumbers(2026, 11, 18);
	aOutages := {{"bal-01 ", dDay, dDay}};
	aArgs := {"BAL-01", dDay, aOutages};
	bActual := ExecFunction("DueDates.Availability.IsAvailable", aArgs);

	:RETURN {"The id in a row is trimmed, any case", .F., bActual};
:ENDPROC;

/* endregion;

/* region Next available day;

:PROCEDURE TestNextAvailableSameDay;
	/* Tuesday 17 is before the outage, so BAL-01 is available that same day;
	:DECLARE aArgs, aOutages, dActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {"BAL-01", DateFromNumbers(2026, 11, 17), aOutages};
	dActual := ExecFunction("DueDates.Availability.NextAvailableDay", aArgs);

	:RETURN {"An available day is returned", "20261117", dActual};
:ENDPROC;

:PROCEDURE TestNextAvailableAfterOutage;
	/* From Wednesday 18, BAL-01 is next available on Friday 20, after its outage;
	:DECLARE aArgs, aOutages, dActual;

	aOutages := ExecFunction("DueDatesTests.TestSupport.DemoOutages");
	aArgs := {"BAL-01", DateFromNumbers(2026, 11, 18), aOutages};
	dActual := ExecFunction("DueDates.Availability.NextAvailableDay", aArgs);

	:RETURN {"Next day is after the outage", "20261120", dActual};
:ENDPROC;

:PROCEDURE TestNextAvailableEmptyDate;
	/* Empty case: no date to start from gives an empty date back, and no walk;
	:DECLARE aArgs, dActual;

	aArgs := {"BAL-01", CToD(""), ExecFunction("DueDatesTests.TestSupport.DemoOutages")};
	dActual := ExecFunction("DueDates.Availability.NextAvailableDay", aArgs);

	:RETURN {"No start, no next available day", "", dActual};
:ENDPROC;

:PROCEDURE TestNextAvailableDayLimit;
	/* An outage with no known end is recorded with a far-off last day. From
	   Wednesday 18 November 2026, one that ends 729 days later leaves the 730th
	   day, 17 November 2028, in reach. One that ends on the 730th day leaves none;
	:DECLARE aArgs, dInReach, dNone, dStart, nLimit, sActual, sFmt;

	sFmt := "";
	nLimit := DoProc("MaxWalkDays");
	dStart := DateFromNumbers(2026, 11, 18);
	aArgs := {"GC-07", dStart, {{"GC-07", dStart, dStart + nLimit - 1}}};
	dInReach := ExecFunction("DueDates.Availability.NextAvailableDay", aArgs);
	aArgs := {"GC-07", dStart, {{"GC-07", dStart, dStart + nLimit}}};
	dNone := ExecFunction("DueDates.Availability.NextAvailableDay", aArgs);
	sActual := sFmt:Format("{0}|{1}", {AllTrim(DToS(dInReach)), AllTrim(DToS(dNone))});

	:RETURN {"The limit: last day in reach, then none", "20281117|", sActual};
:ENDPROC;

/* endregion;
