/********************************************************************************
Description.. : Sets the due date of every sample that has none yet.
Parameters... : -
Returns...... : Success: {.T., {nSet, nSkipped, aSkipped}}, each skip {sSampleId, sCode, sText}
                Failure: {.F., {sCode, sMessage}}, with no due date saved
Author....... :
Date......... : 2026-11-17
********************************************************************************
_______________________________________________________________________________
Modification. : The helpers are private and a skip carries a code with its text.
                Writing is now DueDates.SaveDueDates, which owns the transaction:
                this script reads, works the dates out and hands them over.
                Its answer is read by DueDates.DueDateSummary.Combine.
Author....... :
Date......... : 2026-11-18
_______________________________________________________________________________
********************************************************************************/;

:INCLUDE DueDates.DueDateConstants;

:DECLARE aHolidays, aOutages, aSummary;
:DECLARE oErr;

:TRY;
	aHolidays := DoProc("LoadHolidays");
	aOutages := DoProc("LoadOutages");
	aSummary := DoProc("ApplyDueDates", {aHolidays, aOutages});
:CATCH;
	/* The error text goes to the server log only. The caller gets a fixed code;
	oErr := GetLastSSLError();
	ErrorMes("[ERROR] SetSampleDueDates", Left(oErr:Description, 2000));
	ClearLastSSLError();

	:RETURN {.F., {"DUE_DATES_NOT_SAVED", "No due dates were saved."}};
:ENDTRY;

:RETURN {.T., aSummary};

/* region Loading;

/*
 * Procedure: LoadHolidays
 * Description: Reads the holidays.
 * Returns: the holidays as an array of dates, empty when there are none. Raises on failure
;
/*@private;
:PROCEDURE LoadHolidays;
	:RETURN RunDS("DueDates.Holidays");
:ENDPROC;

/*
 * Procedure: LoadOutages
 * Description: Reads the instrument outages.
 * Returns: rows {sInstrumentId, dFrom, dTo} with dTo included, empty when there are none. Raises on failure
;
/*@private;
:PROCEDURE LoadOutages;
	:RETURN RunDS("DueDates.Outages");
:ENDPROC;

/* endregion;

/* region Due dates;

/*
 * Procedure: ApplyDueDates
 * Description: Works out the due date of each waiting sample, then has them all saved.
 * Parameters:
 *   aHolidays - the holidays, an array of dates
 *   aOutages  - the outages, each row {sInstrumentId, dFrom, dTo}
 * Returns: {nSet, nSkipped, aSkipped}, each skip {sSampleId, sCode, sText}. Raises on any failure
;
/*@private;
:PROCEDURE ApplyDueDates;
	:PARAMETERS aHolidays, aOutages;

	:DECLARE aCombined, aPlan, aSamples, aSaved, aSkipped, aToSave, nIndex, sSampleId;

	aSkipped := {};
	aToSave := {};

	/* Reading and working out come first, so that a transaction is open only
	   while rows are written. RECEIVED_ON is a whole day, read without timezone
	   conversion, and a NULL comes back as the empty value of its column;
	aSamples := LSelect1("
	    SELECT SAMPLE_ID, RECEIVED_ON, PRIORITY, TURNAROUND_DAYS, INSTRUMENT_ID
	    FROM DEMO_SAMPLES
	    WHERE DUE_ON IS NULL
	    ORDER BY SAMPLE_ID
	",,, .T., {"RECEIVED_ON"});

	:FOR nIndex := 1 :TO ALen(aSamples);
		sSampleId := aSamples[nIndex][1];
		aPlan := DoProc("PlanDueDate", {aSamples[nIndex], aHolidays, aOutages});

		:IF Empty(aPlan[2]);
			AAdd(aToSave, {sSampleId, aPlan[1]});
		:ELSE;
			AAdd(aSkipped, {sSampleId, aPlan[2][1], aPlan[2][2]});
		:ENDIF;
	:NEXT;

	/* SaveDueDates owns the writes and their one transaction: all of the dates
	   are saved or none is. It answers with an envelope and logs its own failure;
	aSaved := ExecFunction("DueDates.SaveDueDates", {aToSave});

	/* Combine reads the answer and adds its skips, the samples that stopped
	   waiting after they were read here, to the ones found above. It raises
	   nothing: {sProblem, aSummary} says what was wrong with the answer, if anything;
	aCombined := ExecFunction("DueDates.DueDateSummary.Combine", {aSkipped, aSaved});

	/* Anything but success is raised here, so that the :CATCH of this script
	   gives the caller the one failure the script has;
	:IF .NOT. Empty(aCombined[1]);
		RaiseError(aCombined[1]);
	:ENDIF;

	:RETURN aCombined[2];
:ENDPROC;

/*
 * Procedure: PlanDueDate
 * Description: Works out the due date of one sample, or why it has none. Writes nothing.
 * Parameters:
 *   aSample   - {sSampleId, dReceived, sPriority, nTurnaroundDays, sInstrumentId}
 *   aHolidays - the holidays, an array of dates
 *   aOutages  - the outages, each row {sInstrumentId, dFrom, dTo}
 * Returns: {dDue, aSkip}: the due date and {}, or an empty date and one of the Skip constants
;
/*@private;
:PROCEDURE PlanDueDate;
	:PARAMETERS aSample, aHolidays, aOutages;

	:DECLARE aRuleArgs, dDue, dReceived, nDays, oRule, sInstrumentId, sPriority;

	/* One name for each column that is read, in the order ApplyDueDates selects;
	dReceived := aSample[2];
	sPriority := aSample[3];
	nDays := aSample[4];
	sInstrumentId := aSample[5];

	:IF Empty(dReceived);
		:RETURN {CToD(""), DoProc("SkipNoReceived")};
	:ENDIF;

	/* The rule gives no date for a turnaround of 0 or less either. It is tested
	   here so that the summary can say which of the two reasons applies;
	:IF nDays <= 0;
		:RETURN {CToD(""), DoProc("SkipNoTurnaround")};
	:ENDIF;

	aRuleArgs := {sPriority, nDays, aHolidays, aOutages};
	oRule := ExecFunction("DueDates.DueRules.RuleFor", aRuleArgs);
	dDue := oRule:DueDate(dReceived, sInstrumentId);

	:IF Empty(dDue);
		:RETURN {dDue, DoProc("SkipNotReached")};
	:ENDIF;

	:RETURN {dDue, {}};
:ENDPROC;

/* endregion;
