/********************************************************************************
Description.. : The rush due-date rule: the routine rule, with Saturday as a working day.
Parameters... : nTurnaroundDays - how many days the work takes
                aHolidays       - the holidays, an array of dates
                aOutages        - the outages, each row {sInstrumentId, dFrom, dTo}
Returns...... : -
Author....... :
Date......... : 2026-11-17
********************************************************************************
_______________________________________________________________________________
Modification. : The name is an overridden method, where it was a field written
                after the base constructor ran.
Author....... :
Date......... : 2026-11-18
_______________________________________________________________________________
********************************************************************************/;

:CLASS RushDueRule;
:INHERIT DueDates.DueRule;

/* region Overrides;

/*
 * Procedure: RuleName
 * Description: Names the rule, for the inherited Describe.
 * Returns: "Rush"
;
:PROCEDURE RuleName;
	:RETURN "Rush";
:ENDPROC;

/*
 * Procedure: CountsSaturday
 * Description: Tells whether this rule treats Saturday as a working day.
 * Returns: .T. for rush work. The inherited CountsDay and DueDate ask this method
;
:PROCEDURE CountsSaturday;
	:RETURN .T.;
:ENDPROC;

/*
 * Procedure: Describe
 * Description: Adds the Saturday rule to the description the base class gives.
 * Returns: a text such as "Rush: 2 working days, Saturdays included"
;
:PROCEDURE Describe;
	:DECLARE sFmt;

	sFmt := "";

	:RETURN sFmt:Format("{0}, Saturdays included", {Base:Describe()});
:ENDPROC;

/* endregion;

/*
 * Procedure: Constructor
 * Description: Sets the rule up as the base does.
 * Parameters:
 *   nTurnaroundDays - how many days the work takes. 0 or less means no turnaround
 *   aHolidays       - the holidays, an array of dates
 *   aOutages        - the outages, each row {sInstrumentId, dFrom, dTo} with dTo included
 * Returns: nothing
;
:PROCEDURE Constructor;
	:PARAMETERS nTurnaroundDays, aHolidays, aOutages;

	/* A base constructor that takes parameters does not run on its own for a
	   subclass, so it is called here. An argument the caller left out arrives as
	   NIL and takes the default the base constructor gives it;
	Base:Constructor(nTurnaroundDays, aHolidays, aOutages);
:ENDPROC;
