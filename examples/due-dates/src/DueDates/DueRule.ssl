/********************************************************************************
Description.. : The routine due-date rule: a turnaround counted in working days on which
                the instrument is available.
Parameters... : nTurnaroundDays - how many days the work takes
                aHolidays       - the holidays, an array of dates
                aOutages        - the outages, each row {sInstrumentId, dFrom, dTo}
Returns...... : -
Author....... :
Date......... : 2026-11-17
********************************************************************************
_______________________________________________________________________________
Modification. : A walk stops at the day limit, a turnaround of 0 or less gives no
                due date, and the name is a method a subclass overrides.
Author....... :
Date......... : 2026-11-18
_______________________________________________________________________________
********************************************************************************/;

:CLASS DueRule;

:DECLARE aHolidays, aOutages, nMaxWalkDays, nTurnaroundDays;

/* region Answers a subclass may change;

/*
 * Procedure: RuleName
 * Description: Names the rule, for Describe.
 * Returns: "Routine". A subclass overrides this to change the answer
;
:PROCEDURE RuleName;
	:RETURN "Routine";
:ENDPROC;

/*
 * Procedure: CountsSaturday
 * Description: Tells whether this rule treats Saturday as a working day.
 * Returns: .F. for routine work. A subclass overrides this to change the answer
;
:PROCEDURE CountsSaturday;
	:RETURN .F.;
:ENDPROC;

/*
 * Procedure: Describe
 * Description: Describes the rule in a few words, for a report line or a tooltip.
 * Returns: a text such as "Routine: 5 working days"
;
:PROCEDURE Describe;
	:DECLARE sFmt, sUnit;

	sFmt := "";
	sUnit := IIf(Me:nTurnaroundDays == 1, "working day", "working days");

	:RETURN sFmt:Format("{0}: {1} {2}", {Me:RuleName(), Me:nTurnaroundDays, sUnit});
:ENDPROC;

/* endregion;

/* region Counting days;

/*
 * Procedure: CountsDay
 * Description: Tells whether a day counts toward the turnaround.
 * Parameters:
 *   dDate         - the day to test
 *   sInstrumentId - the instrument the sample needs, or empty when it needs none
 * Returns: .T. when the day is a working day and the instrument is available on it
;
:PROCEDURE CountsDay;
	:PARAMETERS dDate, sInstrumentId;
	:DEFAULT sInstrumentId, "";

	:DECLARE aDayArgs, aOutageArgs;

	/* CountsSaturday is asked through Me: so that a subclass which overrides it
	   changes the days this method, and DueDate with it, accepts;
	aDayArgs := {dDate, Me:aHolidays, Me:CountsSaturday()};

	:IF .NOT. ExecFunction("DueDates.WorkCalendar.IsWorkingDay", aDayArgs);
		:RETURN .F.;
	:ENDIF;

	aOutageArgs := {sInstrumentId, dDate, Me:aOutages};

	:RETURN ExecFunction("DueDates.Availability.IsAvailable", aOutageArgs);
:ENDPROC;

/*
 * Procedure: DueDate
 * Description: Works out the day a sample is due. This is the one walk through the days.
 * Parameters:
 *   dReceived     - the day the sample was received, which is not counted itself
 *   sInstrumentId - the instrument the sample needs, or empty when it needs none
 * Returns: the due day, or an empty date when dReceived is empty, the turnaround is 0 or less, or the turnaround is not reached within the day limit
;
:PROCEDURE DueDate;
	:PARAMETERS dReceived, sInstrumentId;
	:DEFAULT sInstrumentId, "";

	:DECLARE dDay, dLast, nCounted;

	/* Nothing to count from, or nothing to count. An empty date also stays empty
	   when a day is added, so a walk that started from one would never move;
	:IF Empty(dReceived) .OR. Me:nTurnaroundDays <= 0;
		:RETURN CToD("");
	:ENDIF;

	dDay := dReceived;
	dLast := dReceived + Me:nMaxWalkDays;
	nCounted := 0;

	:WHILE nCounted < Me:nTurnaroundDays .AND. dDay < dLast;
		dDay := dDay + 1;

		:IF Me:CountsDay(dDay, sInstrumentId);
			nCounted += 1;
		:ENDIF;
	:ENDWHILE;

	/* The limit came first: a long outage, or a turnaround longer than the limit.
	   No date is better than one that is wrong;
	:IF nCounted < Me:nTurnaroundDays;
		:RETURN CToD("");
	:ENDIF;

	:RETURN dDay;
:ENDPROC;

/* endregion;

/*
 * Procedure: Constructor
 * Description: Keeps the turnaround and the calendar the rule counts against.
 * Parameters:
 *   nTurnaroundDays - how many days the work takes. 0 or less means no turnaround
 *   aHolidays       - the holidays, an array of dates
 *   aOutages        - the outages, each row {sInstrumentId, dFrom, dTo} with dTo included
 * Returns: nothing
;
:PROCEDURE Constructor;
	:PARAMETERS nTurnaroundDays, aHolidays, aOutages;
	:DEFAULT nTurnaroundDays, 0;
	:DEFAULT aHolidays, {};
	:DEFAULT aOutages, {};

	Me:nTurnaroundDays := nTurnaroundDays;
	Me:aHolidays := aHolidays;
	Me:aOutages := aOutages;

	/* An :INCLUDE here would make every shared constant a method of the rule, so
	   the limit is asked for by its three-part name, once for each rule;
	Me:nMaxWalkDays := ExecFunction("DueDates.DueDateConstants.MaxWalkDays");
:ENDPROC;
