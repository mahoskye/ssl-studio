/********************************************************************************
Description.. : Working-day rules for due dates: weekends, holidays and counting forward.
Parameters... : -
Returns...... : -
Author....... :
Date......... : 2026-11-17
********************************************************************************
_______________________________________________________________________________
Modification. : An empty date is handled on purpose, counting forward uses the
                walk of the rule classes in place of a second one, and the
                constants are read as procedures of the include.
Author....... :
Date......... : 2026-11-18
_______________________________________________________________________________
********************************************************************************/;

:INCLUDE DueDates.DueDateConstants;

/* region Day tests;

/*
 * Procedure: IsWeekend
 * Description: Tells whether a date falls on a weekend.
 * Parameters:
 *   dDate          - the date to test
 *   bCountSaturday - .T. when Saturday is a working day (rush work)
 * Returns: .T. on a Sunday, and on a Saturday unless bCountSaturday is .T. An empty date is .F.
;
:PROCEDURE IsWeekend;
	:PARAMETERS dDate, bCountSaturday;
	:DEFAULT bCountSaturday, .F.;

	:DECLARE nWeekday;

	/* DOW numbers the week from Sunday = 1 to Saturday = 7, and gives 0 for an
	   empty date. An empty date is no day of the week, so it is said here and not
	   left to fall through the tests below;
	:IF Empty(dDate);
		:RETURN .F.;
	:ENDIF;

	nWeekday := DOW(dDate);

	:IF nWeekday == 7;
		:RETURN .NOT. bCountSaturday;
	:ENDIF;

	:RETURN nWeekday == 1;
:ENDPROC;

/*
 * Procedure: IsHoliday
 * Description: Tells whether a date is in the list of holidays.
 * Parameters:
 *   dDate     - the date to test
 *   aHolidays - the holidays, an array of dates
 * Returns: .T. when the date is a holiday, .F. otherwise and for an empty list
;
:PROCEDURE IsHoliday;
	:PARAMETERS dDate, aHolidays;
	:DEFAULT aHolidays, {};

	:DECLARE nIndex;

	:FOR nIndex := 1 :TO ALen(aHolidays);
		:IF aHolidays[nIndex] == dDate;
			:RETURN .T.;
		:ENDIF;
	:NEXT;

	:RETURN .F.;
:ENDPROC;

/*
 * Procedure: IsWorkingDay
 * Description: Tells whether work is done on a date.
 * Parameters:
 *   dDate          - the date to test
 *   aHolidays      - the holidays, an array of dates
 *   bCountSaturday - .T. when Saturday is a working day (rush work)
 * Returns: .T. when the date is neither a weekend day nor a holiday. An empty date is .F.
;
:PROCEDURE IsWorkingDay;
	:PARAMETERS dDate, aHolidays, bCountSaturday;
	:DEFAULT aHolidays, {};
	:DEFAULT bCountSaturday, .F.;

	/* An empty date is neither a weekend day nor a holiday, and still no day on
	   which work is done;
	:IF Empty(dDate) .OR. DoProc("IsWeekend", {dDate, bCountSaturday});
		:RETURN .F.;
	:ENDIF;

	:RETURN .NOT. DoProc("IsHoliday", {dDate, aHolidays});
:ENDPROC;

/* endregion;

/* region Counting forward;

/*
 * Procedure: NextWorkingDay
 * Description: Finds the first working day on or after a date.
 * Parameters:
 *   dDate          - the date to start from
 *   aHolidays      - the holidays, an array of dates
 *   bCountSaturday - .T. when Saturday is a working day (rush work)
 * Returns: dDate when it is a working day, otherwise the next one. An empty date for an empty dDate, or when none is found within the day limit
;
:PROCEDURE NextWorkingDay;
	:PARAMETERS dDate, aHolidays, bCountSaturday;
	:DEFAULT aHolidays, {};
	:DEFAULT bCountSaturday, .F.;

	:IF Empty(dDate);
		:RETURN dDate;
	:ENDIF;

	/* The first working day on or after a date is one working day counted from
	   the day before it;
	:RETURN DoProc("AddWorkingDays", {dDate - 1, 1, aHolidays, bCountSaturday});
:ENDPROC;

/*
 * Procedure: AddWorkingDays
 * Description: Counts working days forward from the day after a start date.
 * Parameters:
 *   dStart         - the date to count from, which is not counted itself
 *   nDays          - how many working days to count
 *   aHolidays      - the holidays, an array of dates
 *   bCountSaturday - .T. when Saturday is a working day (rush work)
 * Returns: the last day counted. dStart unchanged when it is empty or nDays is 0 or less. An empty date when nDays is not reached within the day limit
;
:PROCEDURE AddWorkingDays;
	:PARAMETERS dStart, nDays, aHolidays, bCountSaturday;
	:DEFAULT nDays, 0;
	:DEFAULT aHolidays, {};
	:DEFAULT bCountSaturday, .F.;

	:DECLARE oRule, sPriority;

	:IF Empty(dStart) .OR. nDays <= 0;
		:RETURN dStart;
	:ENDIF;

	/* A due date with no instrument is working days counted forward, so the rule
	   classes do the counting. There is one walk through the days, and its limit
	   and the Saturday rule are theirs;
	sPriority := DoProc("PriorityRoutine");

	:IF bCountSaturday;
		sPriority := DoProc("PriorityRush");
	:ENDIF;

	oRule := ExecFunction("DueDates.DueRules.RuleFor", {sPriority, nDays, aHolidays});

	:RETURN oRule:DueDate(dStart);
:ENDPROC;

/*
 * Procedure: WorkingDaysUntil
 * Description: Counts the working days after a day, up to and including a later day.
 * Parameters:
 *   dFrom          - the day to count from, which is not counted itself
 *   dTo            - the last day to count
 *   aHolidays      - the holidays, an array of dates
 *   bCountSaturday - .T. when Saturday is a working day (rush work)
 * Returns: the number of working days. 0 for an empty date or when dTo is not after dFrom. A span longer than the day limit is counted up to the limit
;
:PROCEDURE WorkingDaysUntil;
	:PARAMETERS dFrom, dTo, aHolidays, bCountSaturday;
	:DEFAULT aHolidays, {};
	:DEFAULT bCountSaturday, .F.;

	:DECLARE dDay, dLast, nCount;

	nCount := 0;

	:IF Empty(dFrom) .OR. Empty(dTo);
		:RETURN nCount;
	:ENDIF;

	dLast := Min(dTo, dFrom + DoProc("MaxWalkDays"));
	dDay := DoProc("NextWorkingDay", {dFrom + 1, aHolidays, bCountSaturday});

	/* From one working day to the next. An empty day means none is in reach;
	:WHILE .NOT. Empty(dDay) .AND. dDay <= dLast;
		nCount += 1;
		dDay := DoProc("NextWorkingDay", {dDay + 1, aHolidays, bCountSaturday});
	:ENDWHILE;

	:RETURN nCount;
:ENDPROC;

/* endregion;
