:INCLUDE DueDates.DueDateConstants;

/*
 * Procedure: RuleFor
 * Description: Picks the due-date rule for a priority.
 * Parameters:
 *   sPriority - RUSH for the rush rule, anything else for the routine rule
 *   nDays     - the turnaround, how many days the work takes
 *   aHolidays - the holidays, an array of dates
 *   aOutages  - the outages, each row {sInstrumentId, dFrom, dTo} with dTo included
 * Returns: a DueDates.RushDueRule object for RUSH in any case, otherwise a DueDates.DueRule
;
:PROCEDURE RuleFor;
	:PARAMETERS sPriority, nDays, aHolidays, aOutages;
	:DEFAULT sPriority, "";
	:DEFAULT nDays, 0;
	:DEFAULT aHolidays, {};
	:DEFAULT aOutages, {};

	/* The priority is typed by people, so it is matched trimmed and in any case;
	:IF Upper(AllTrim(sPriority)) == DoProc("PriorityRush");
		:RETURN CreateUdObject("DueDates.RushDueRule", {nDays, aHolidays, aOutages});
	:ENDIF;

	:RETURN CreateUdObject("DueDates.DueRule", {nDays, aHolidays, aOutages});
:ENDPROC;
