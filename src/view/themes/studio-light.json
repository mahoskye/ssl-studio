{
	"name": "Studio Light",
	"type": "light",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"method": "#0f766e",
		"variable.defaultLibrary": "#cf226f",
		"variable.public": { "foreground": "#c2410c", "italic": true },
		"variable.unknown": { "foreground": "#dc2626", "underline": true }
	},
	"colors": {
		"editor.background": "#fbfbfc",
		"editor.foreground": "#2b2f36",
		"editorLineNumber.foreground": "#676f7e",
		"editorLineNumber.activeForeground": "#4c525e",
		"editor.selectionBackground": "#cfdcf5",
		"editor.lineHighlightBackground": "#f1f3f6",
		"editorCursor.foreground": "#7a36ed",
		"editorIndentGuide.background1": "#e6e8ec",
		"editorWhitespace.foreground": "#d0d4da",
		"sideBar.background": "#f3f4f6",
		"sideBar.foreground": "#353a43",
		"sideBar.border": "#e1e4e8",
		"panel.background": "#f3f4f6",
		"panel.border": "#e1e4e8",
		"statusBar.background": "#e9ebef",
		"statusBar.foreground": "#4c525e",
		"tab.activeBackground": "#fbfbfc",
		"tab.inactiveBackground": "#eceef1",
		"tab.activeForeground": "#1f2329",
		"tab.inactiveForeground": "#5f6571",
		"focusBorder": "#7a36ed",
		"editorBracketHighlight.foreground1": "#2f5fd0",
		"editorBracketHighlight.foreground2": "#2f7d32",
		"editorBracketHighlight.foreground3": "#8a4b12",
		"editorBracketHighlight.foreground4": "#2f5fd0",
		"editorBracketHighlight.foreground5": "#2f7d32",
		"editorBracketHighlight.foreground6": "#8a4b12",
		"editorBracketHighlight.unexpectedBracket.foreground": "#be123c",
		"button.background": "#7a36ed",
		"button.foreground": "#ffffff",
		"input.background": "#ffffff",
		"input.foreground": "#2b2f36",
		"input.border": "#838ea0",
		"list.hoverBackground": "#e8eaee",
		"list.activeSelectionBackground": "#dde3f0",
		"descriptionForeground": "#5f6571",
		"editorError.foreground": "#be2841",
		"editorWarning.foreground": "#895b17",
		"editorInfo.foreground": "#2966a7",
		"testing.iconPassed": "#267238"
	},
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#686f79", "fontStyle": "italic" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#2f7d32" } },
		{ "scope": "string.quoted.double.identifier", "settings": { "foreground": "#3b7a0f" } },
		{ "scope": "constant.numeric", "settings": { "foreground": "#b45309" } },
		{ "scope": "constant.language", "settings": { "foreground": "#b45309", "fontStyle": "bold" } },
		{ "scope": "keyword.control", "settings": { "foreground": "#7c3aed", "fontStyle": "bold" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#0e7490" } },
		{ "scope": "keyword.other.database-parameter", "settings": { "foreground": "#c2410c" } },
		{ "scope": "storage.modifier", "settings": { "foreground": "#7c3aed" } },
		{ "scope": ["support.function", "support.class"], "settings": { "foreground": "#1d4ed8" } },
		{ "scope": "support.function.method", "settings": { "foreground": "#0f766e" } },
		{ "scope": ["entity.name.function", "entity.name.type", "entity.name.module", "entity.other.inherited-class"], "settings": { "foreground": "#9d6007" } },
		{ "scope": "entity.name.label", "settings": { "foreground": "#c2410c" } },
		{ "scope": "variable.parameter", "settings": { "foreground": "#be123c" } },
		{ "scope": "variable.language", "settings": { "foreground": "#cf226f" } },
		{ "scope": "variable.other.property", "settings": { "foreground": "#475569" } },
		{ "scope": "markup.heading", "settings": { "foreground": "#7c3aed", "fontStyle": "bold" } },
		{ "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
		{ "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
		{ "scope": "markup.inline.raw", "settings": { "foreground": "#0f766e" } },
		{ "scope": "markup.underline.link", "settings": { "foreground": "#1d4ed8", "fontStyle": "underline" } },
		{ "scope": "entity.name.tag", "settings": { "foreground": "#be123c" } },
		{ "scope": "entity.other.attribute-name", "settings": { "foreground": "#9d6007" } },
		{ "scope": "support.type.property-name", "settings": { "foreground": "#1d4ed8" } },
		{ "scope": "entity.name.section", "settings": { "foreground": "#9d6007", "fontStyle": "bold" } },
		{ "scope": "constant.character.escape", "settings": { "foreground": "#0e7490" } },
		{ "scope": "invalid", "settings": { "foreground": "#d02c47", "fontStyle": "underline" } }
	]
}
