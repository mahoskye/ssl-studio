{
	"name": "Studio Light",
	"type": "light",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"method": "#0f766e",
		"variable.defaultLibrary": "#db2777",
		"variable.public": { "foreground": "#c2410c", "italic": true },
		"variable.unknown": { "foreground": "#dc2626", "underline": true }
	},
	"colors": {
		"editor.background": "#fbfbfc",
		"editor.foreground": "#2b2f36",
		"editorLineNumber.foreground": "#a3a9b4",
		"editorLineNumber.activeForeground": "#4c525e",
		"editor.selectionBackground": "#cfdcf5",
		"editor.lineHighlightBackground": "#f1f3f6",
		"editorCursor.foreground": "#7c3aed",
		"editorIndentGuide.background1": "#e6e8ec",
		"editorWhitespace.foreground": "#d0d4da",
		"sideBar.background": "#f3f4f6",
		"sideBar.foreground": "#353a43",
		"sideBar.border": "#e1e4e8",
		"panel.background": "#f3f4f6",
		"panel.border": "#e1e4e8",
		"statusBar.background": "#e9ebef",
		"statusBar.foreground": "#4c525e",
		"tab.activeBackground": "#fbfbfc",
		"tab.inactiveBackground": "#eceef1",
		"tab.activeForeground": "#1f2329",
		"tab.inactiveForeground": "#6b7280",
		"focusBorder": "#7c3aed",
		"button.background": "#7c3aed",
		"button.foreground": "#ffffff",
		"input.background": "#ffffff",
		"input.foreground": "#2b2f36",
		"input.border": "#d5d9df",
		"list.hoverBackground": "#e8eaee",
		"list.activeSelectionBackground": "#dde3f0",
		"descriptionForeground": "#6b7280",
		"editorError.foreground": "#d32f4a",
		"editorWarning.foreground": "#b7791f",
		"editorInfo.foreground": "#2b6cb0"
	},
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#6e7681", "fontStyle": "italic" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#2f7d32" } },
		{ "scope": "string.quoted.double.identifier", "settings": { "foreground": "#3b7a0f" } },
		{ "scope": "constant.numeric", "settings": { "foreground": "#b45309" } },
		{ "scope": "constant.language", "settings": { "foreground": "#b45309", "fontStyle": "bold" } },
		{ "scope": "keyword.control", "settings": { "foreground": "#7c3aed", "fontStyle": "bold" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#0e7490" } },
		{ "scope": "keyword.other.database-parameter", "settings": { "foreground": "#c2410c" } },
		{ "scope": "storage.modifier", "settings": { "foreground": "#7c3aed" } },
		{ "scope": ["support.function", "support.class"], "settings": { "foreground": "#1d4ed8" } },
		{ "scope": "support.function.method", "settings": { "foreground": "#0f766e" } },
		{ "scope": ["entity.name.function", "entity.name.type", "entity.name.module", "entity.other.inherited-class"], "settings": { "foreground": "#a16207" } },
		{ "scope": "entity.name.label", "settings": { "foreground": "#c2410c" } },
		{ "scope": "variable.parameter", "settings": { "foreground": "#be123c" } },
		{ "scope": "variable.language", "settings": { "foreground": "#db2777" } },
		{ "scope": "variable.other.property", "settings": { "foreground": "#475569" } },
		{ "scope": "invalid", "settings": { "foreground": "#d32f4a", "fontStyle": "underline" } }
	]
}
