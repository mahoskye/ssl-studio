{
	"name": "Studio Dark",
	"type": "dark",
	"colors": {
		"editor.background": "#1b1d23",
		"editor.foreground": "#d4d7de",
		"editorLineNumber.foreground": "#4f5562",
		"editorLineNumber.activeForeground": "#a9afbc",
		"editor.selectionBackground": "#2f3b54",
		"editor.lineHighlightBackground": "#22252c",
		"editorCursor.foreground": "#f0c674",
		"editorIndentGuide.background1": "#2a2e36",
		"editorWhitespace.foreground": "#3a3f4b",
		"sideBar.background": "#191b20",
		"sideBar.foreground": "#c2c7d0",
		"sideBar.border": "#262931",
		"panel.background": "#191b20",
		"panel.border": "#262931",
		"statusBar.background": "#15171b",
		"statusBar.foreground": "#9aa1ae",
		"tab.activeBackground": "#1b1d23",
		"tab.inactiveBackground": "#16181d",
		"tab.activeForeground": "#e6e9ef",
		"tab.inactiveForeground": "#8a91a0",
		"focusBorder": "#c792ea",
		"button.background": "#7c5cbf",
		"button.foreground": "#ffffff",
		"input.background": "#22252c",
		"input.foreground": "#d4d7de",
		"input.border": "#30343d",
		"list.hoverBackground": "#23262e",
		"list.activeSelectionBackground": "#2c3140",
		"descriptionForeground": "#7f8796",
		"editorError.foreground": "#ff5370",
		"editorWarning.foreground": "#ffcb6b",
		"editorInfo.foreground": "#82aaff"
	},
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#7f8796", "fontStyle": "italic" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#a8cc8c" } },
		{ "scope": "string.quoted.double.identifier", "settings": { "foreground": "#c3e88d" } },
		{ "scope": "constant.numeric", "settings": { "foreground": "#e5a96b" } },
		{ "scope": "constant.language", "settings": { "foreground": "#e5a96b", "fontStyle": "bold" } },
		{ "scope": "keyword.control", "settings": { "foreground": "#c792ea", "fontStyle": "bold" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#89ddff" } },
		{ "scope": "keyword.other.database-parameter", "settings": { "foreground": "#f78c6c" } },
		{ "scope": "storage.modifier", "settings": { "foreground": "#c792ea" } },
		{ "scope": ["support.function", "support.class"], "settings": { "foreground": "#82aaff" } },
		{ "scope": "support.function.method", "settings": { "foreground": "#7fdbca" } },
		{ "scope": ["entity.name.function", "entity.name.type", "entity.name.module", "entity.other.inherited-class"], "settings": { "foreground": "#ffcb6b" } },
		{ "scope": "entity.name.label", "settings": { "foreground": "#f78c6c" } },
		{ "scope": "variable.parameter", "settings": { "foreground": "#f07178" } },
		{ "scope": "variable.language", "settings": { "foreground": "#ff9cac" } },
		{ "scope": "variable.other.property", "settings": { "foreground": "#b2ccd6" } },
		{ "scope": "invalid", "settings": { "foreground": "#ff5370", "fontStyle": "underline" } }
	]
}
